{
    "name": "Rust",
    "image": "mcr.microsoft.com/devcontainers/rust:latest",
    // Specifies the user that VS Code/CLI should run as inside the container
    "remoteUser": "vscode",
    // Tells the devcontainer to automatically match your host UID/GID
    "updateRemoteUserUID": true,
    // Configure tool-specific properties.
    "customizations": {
        // Configure properties specific to VS Code.
        "vscode": {
            // Add the IDs of extensions you want installed when the container is created.
            "extensions": [
                "ms-azuretools.vscode-docker",
                "rust-lang.rust-analyzer",
                "svelte.svelte-vscode",
                "tamasfe.even-better-toml"
            ],
            "settings": {
                "remote.portsAttributes": {
                    // Forward standard ports if they show up
                    "8000-9000": {
                        "onAutoForward": "notify"
                    },
                    // Ignore auto forwarding for other high ports
                    "10000-65535": {
                        "onAutoForward": "ignore"
                    }
                },
                "rust-analyzer.check.command": "clippy",
                "rust-analyzer.cargo.buildScripts.enable": true,
                "rust-analyzer.procMacro.enable": true
            }
        }
    },
    // Features to add to the dev container. More info: https://containers.dev/features.
    "features": {
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
        "ghcr.io/devcontainers/features/git:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "version": "latest",
            "enableNonRootDocker": "true",
            "moby": false
        }
    },
    "containerEnv": {
        "GPG_TTY": "${localEnv:GPG_TTY}"
    },
    // Use 'mounts' to make the cargo cache persistent in a Docker Volume.
    "mounts": [
        "source=devcontainer-cargo-cache-${devcontainerId},target=/usr/local/cargo,type=volume",
        "source=claude-code-config-saurron,target=/home/vscode/.claude,type=volume",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude/CLAUDE.md,target=/home/vscode/.claude/CLAUDE.md,type=bind,consistency=cached",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude/.credentials.json,target=/home/vscode/.claude/.credentials.json,type=bind,consistency=cached"
    ],
    "postAttachCommand": "sudo chown vscode:vscode /home/vscode/.claude && sudo chown -R vscode:rustlang /usr/local/cargo",
    // Use 'postCreateCommand' to run commands after the container is created.
    "postCreateCommand": "rustc --version",
    // Use 'postStartCommand' to run commands every time the container is started.
    "postStartCommand": "rustc --version",
   "updateContentCommand": "bash ${containerWorkspaceFolder}/.devcontainer/update-content.sh ${containerWorkspaceFolder}"    
}